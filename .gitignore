/app/bin/

# Foojay / updateDaemonJvm regenerate this locally and on demand.
gradle/gradle-daemon-jvm.properties

# --- Local machine / secrets (never commit) ---
local.properties
*.keystore
*.jks
keystore.properties
secrets.properties

# --- IDE / editor ---
*.iml
*.ipr
*.iws
.idea/
.fleet/
*.swp
*.swo
*~

# --- OS junk ---
.DS_Store
Thumbs.db

# --- Packaging / bytecode / profiler dumps ---
*.apk
*.ap_
*.aab
*.dex
*.class
*.hprof
output.json

# --- Local run / agent logs ---
*.log
emulator.pid

# Codex CLI review dumps (local only)
tasks/codex/

# --- IDE inspection export dumps (local only) ---
/Inspections/

#!/usr/bin/env bash
# Lean local proof gate for super_demo_android (adapted from iOS checklist spirit).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if [[ -z "${JAVA_HOME:-}" ]]; then
  if command -v /usr/libexec/java_home >/dev/null 2>&1; then
    JAVA_HOME="$(/usr/libexec/java_home -v 21 2>/dev/null || /usr/libexec/java_home 2>/dev/null || true)"
  fi
fi
if [[ -z "${JAVA_HOME:-}" || ! -x "${JAVA_HOME}/bin/java" ]]; then
  echo "ERROR: Set JAVA_HOME to a JDK 17+ (21 recommended)." >&2
  exit 1
fi
export JAVA_HOME
export ANDROID_HOME="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk}}"
export PATH="$JAVA_HOME/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH"

if ! command -v adb >/dev/null 2>&1; then
  echo "ERROR: adb not found. Set ANDROID_HOME to an Android SDK with platform-tools." >&2
  exit 1
fi

DEVICE_SERIAL="${ANDROID_SERIAL:-}"
if [[ -z "$DEVICE_SERIAL" ]]; then
  DEVICE_SERIAL="$(adb devices | awk '/emulator-.*device$/{print $1; exit}')"
fi
if [[ -z "$DEVICE_SERIAL" ]]; then
  DEVICE_SERIAL="$(adb devices | awk '/\tdevice$/{print $1; exit}')"
fi

echo "==> Unit tests"
./gradlew testDebugUnitTest --stacktrace

echo "==> Assemble debug + androidTest"
./gradlew :app:assembleDebug :app:assembleDebugAndroidTest --stacktrace

echo "==> Android Lint"
./gradlew :app:lintDebug --stacktrace

if [[ -n "$DEVICE_SERIAL" ]]; then
  export ANDROID_SERIAL="$DEVICE_SERIAL"
  # Fresh install state so Items seed-once + Feed Room seed are deterministic on a reused device.
  # Debug builds use applicationIdSuffix ".debug" (see app/build.gradle.kts).
  DEBUG_APP_ID="com.redjadet.superdemo.debug"
  echo "==> Clear app data for instrumentation ($DEBUG_APP_ID) on $DEVICE_SERIAL"
  if adb -s "$DEVICE_SERIAL" shell pm path "$DEBUG_APP_ID" >/dev/null 2>&1; then
    adb -s "$DEVICE_SERIAL" shell pm clear "$DEBUG_APP_ID"
  else
    echo "    (package not installed yet; connectedDebugAndroidTest will install)"
  fi
  echo "==> Connected instrumentation"
  ./gradlew connectedDebugAndroidTest --stacktrace
else
  echo "ERROR: No device/emulator in 'adb devices' with state 'device'." >&2
  echo "Start any AVD (this Mac often uses Small_Phone_3) or set ANDROID_SERIAL." >&2
  exit 1
fi

echo "Checklist green."
echo "Device: ${DEVICE_SERIAL}"
echo "JAVA_HOME: ${JAVA_HOME}"

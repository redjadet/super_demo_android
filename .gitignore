/AndroidLint*.xml
/Annotator.xml
/CheckEmptyScriptTag.xml
/GrazieInspection.xml
/GrazieStyle.xml
/HtmlUnknown*.xml
/IgnoreFileDuplicateEntry.xml
/Markdown*.xml
/RedundantSamConstructor.xml
/SpellCheckingInspection.xml
/UnstableApiUsage.xml
/UnusedSymbol.xml
/UsePropertyAccessSyntax.xml
/.descriptions.xml
